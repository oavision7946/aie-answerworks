# Secrets only. Copy to .env and fill in. Never commit .env.
# Non-secret settings live in config/*.yaml.

# --- LLM provider keys (names must match api_key_env in config/providers.yaml) ---
ANTHROPIC_API_KEY=
# Only if your Anthropic key is not scoped to a workspace (API error: "must include the
# anthropic-workspace-id header"). Leave empty otherwise.
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
LOCAL_LLM_API_KEY=

# --- Database ---
DATABASE_URL=postgresql+psycopg://answerworks:answerworks@localhost:5432/answerworks
POSTGRES_USER=answerworks
POSTGRES_PASSWORD=answerworks
POSTGRES_DB=answerworks

# --- Auth ---
# Required: at least 16 random characters (e.g. `openssl rand -hex 32`). Login returns 503 without it.
JWT_SECRET=

# --- Observability (see docs/observability.md) ---
# Optional: turns on GET /metrics (Prometheus format); scrape it with this value as a bearer token.
# Empty keeps the endpoint off. The monitoring profile needs it, or the ApiDown alert fires
# (e.g. `openssl rand -hex 32`).
METRICS_TOKEN=
# DEBUG, INFO, WARNING or ERROR. INFO adds the request-id log lines; empty means WARNING.
LOG_LEVEL=INFO
# TRACING_ENABLED=true turns span export on for the API, scheduler and web app, and OTLP_ENDPOINT
# says where to (both override config/monitoring.yaml). This address is for an API started on the
# host; Compose sets http://otel-collector:4318 for its own services.
TRACING_ENABLED=
OTLP_ENDPOINT=http://localhost:4318
# Only for an OTLP endpoint that needs credentials, e.g. Authorization=Bearer <token>. The
# collector in the monitoring profile needs none.
OTEL_EXPORTER_OTLP_HEADERS=

# --- Monitoring profile (docker compose --profile monitoring up -d) ---
# Grafana's own administrator login. Replace the password (e.g. `openssl rand -base64 18`).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
# Signs the dashboard links and the identity the API passes to Grafana. At least 16 characters and
# different from JWT_SECRET: replace it (e.g. `openssl rand -hex 32`), because anyone who knows
# this value can sign in to Grafana. Grafana does not start without it.
MONITORING_JWT_SECRET=change-me-use-openssl-rand-hex-32
# The address browsers use for the API (it becomes Grafana's root URL), and where the API reaches
# Grafana when the API runs on the host (Compose sets it for the API container).
API_PUBLIC_URL=http://localhost:8000
GRAFANA_URL=http://localhost:3000
# Where Prometheus scrapes the model server's /metrics (match vLLM's --port) and the host GPU
# exporter (`cd api && uv run python -m scripts.gpu_exporter --host 0.0.0.0`). Both run on the host.
VLLM_METRICS_TARGET=host.docker.internal:8001
GPU_EXPORTER_TARGET=host.docker.internal:9835

# --- First administrator ---
# Used only by `make create-admin` (leave empty to be prompted). Password: 12-128 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- UI ---
API_BASE_URL=http://localhost:8000
