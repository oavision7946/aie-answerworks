# Secrets only. Copy to .env and fill in. Never commit .env.
# Non-secret settings live in config/*.yaml.

# --- LLM provider keys (names must match api_key_env in config/providers.yaml) ---
ANTHROPIC_API_KEY=
# Only if your Anthropic key is not scoped to a workspace (API error: "must include the
# anthropic-workspace-id header"). Leave empty otherwise.
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
LOCAL_LLM_API_KEY=

# --- Database ---
DATABASE_URL=postgresql+psycopg://answerworks:answerworks@localhost:5432/answerworks
POSTGRES_USER=answerworks
POSTGRES_PASSWORD=answerworks
POSTGRES_DB=answerworks

# --- Auth ---
# Required: at least 16 random characters (e.g. `openssl rand -hex 32`). Login returns 503 without it.
JWT_SECRET=
# Optional: turns on GET /metrics (Prometheus format); scrape it with this value as a bearer token.
# Leave empty to keep the endpoint off.
METRICS_TOKEN=
LOG_LEVEL=
# Used only by `make create-admin` (leave empty to be prompted). Password: 12-128 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- UI ---
API_BASE_URL=http://localhost:8000
