      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(answerworks_request_duration_seconds_bucket[5m])))",
          "refId": "A",
          "instant": true
